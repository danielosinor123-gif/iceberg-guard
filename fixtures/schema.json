{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iceberg-guard events fixture",
  "type": "object",
  "required": ["ts", "category", "tenant", "join_key", "measure"],
  "properties": {
    "ts": {"type": "integer", "description": "seconds since epoch"},
    "category": {"type": "string", "enum": ["growth", "core", "legacy", "experiment"]},
    "tenant": {"type": "string", "pattern": "^tenant-[0-9]{3}$"},
    "join_key": {"type": "integer", "minimum": 1, "maximum": 49999},
    "measure": {"type": "number", "minimum": 0}
  }
}
